<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Atropa</vendor>
  <action id="org.atropa.pkexec.run">
    <description>Run an Atropa system administration command</description>
    <message>Authentication is required to change system settings via Atropa</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- "keep" is the point: polkit remembers this authentication for its
           keep window (5 minutes by default) so a multi-step operation asks
           once instead of once per tool. -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <!-- pkexec only uses this action for the annotated program path; without
         this annotation every call fell back to org.freedesktop.policykit.exec
         (auth_admin, never remembered), which is why the password was asked
         for constantly. -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/atropa/atropa-helper</annotate>
  </action>
</policyconfig>
