
module atropa_fwupdmgr_fwupdmgr_t 1.0;

require {
	type xdg_cache_t;
	type fwupdmgr_t;
	type gnome_xdg_config_t;
	type fs_t;
	type xdg_config_t;
	type xdg_data_t;
	class dir { getattr read search watch };
	class filesystem getattr;
	class file { getattr map open read };
}

#============= fwupdmgr_t ==============
allow fwupdmgr_t fs_t:filesystem getattr;
allow fwupdmgr_t gnome_xdg_config_t:dir search;
allow fwupdmgr_t gnome_xdg_config_t:file { getattr map open read };
allow fwupdmgr_t xdg_cache_t:dir { getattr search };
allow fwupdmgr_t xdg_config_t:dir { read watch };
allow fwupdmgr_t xdg_config_t:file { getattr open read };
allow fwupdmgr_t xdg_data_t:dir search;
