# Maintainer: whitewhistlegit <dusdamian4@gmail.com>
pkgname=atropa-git
_pkgname=atropa-GUI
pkgver=0.1.0.r58.g3004b5a
pkgrel=1
pkgdesc="A YaST-inspired system control center for Arch Linux"
arch=('any')
url="https://github.com/whitewhistlegit/atropa-GUI"
license=('GPL-3.0-or-later')
# The core tools Atropa can't work without (backend/dependencies.py marks
# them required); everything else it detects at runtime.
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'polkit' 'pacman' 'systemd')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=(
    'networkmanager: Network page (connections, Wi-Fi, static IP)'
    'pacman-contrib: check for updates without touching the package database'
    'fakeroot: needed by checkupdates'
    'arch-audit: vulnerability scan'
    'grub: regenerate GRUB configuration'
    'ufw: firewall management'
    'firewalld: firewall management (alternative to ufw)'
    'openssh: SSH hardening toggles'
    'sudo: fallback privilege escalation and sudoers checking'
    'fail2ban: ban IPs after repeated failed logins'
    'apparmor: AppArmor profile management'
    'usbguard: USB device allow-listing'
    'audit: audit logging and SELinux denial review'
)
provides=('atropa')
conflicts=('atropa')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    local version
    version=$(sed -n 's/^version = "\(.*\)"/\1/p' pyproject.toml)
    printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$_pkgname"
    python -m build --wheel --no-isolation
}

check() {
    cd "$_pkgname"
    python -m pytest
}

package() {
    cd "$_pkgname"
    python -m installer --destdir="$pkgdir" dist/*.whl

    install -Dm644 atropa/resources/atropa.desktop -t "$pkgdir/usr/share/applications/"
    install -Dm644 atropa/resources/org.atropa.pkexec.policy -t "$pkgdir/usr/share/polkit-1/actions/"
    local icon
    for icon in atropa/resources/icons/hicolor/*/apps/org.atropa.Atropa.png; do
        install -Dm644 "$icon" "$pkgdir/usr/share/icons/${icon#atropa/resources/icons/}"
    done
}
