# Maintainer: whitewhistlegit <dusdamian4@gmail.com>
pkgname=atropa-git
_pkgname=atropa-GUI
pkgver=0.1.0.r64.ge70f1ad
pkgrel=1
pkgdesc="A YaST-inspired system control center for Arch Linux"
arch=('any')
url="https://github.com/whitewhistlegit/atropa-GUI"
license=('GPL-3.0-or-later')
# The core tools Atropa can't work without (backend/dependencies.py marks
# them required); everything else it detects at runtime.
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'polkit' 'pacman' 'systemd')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=(
    'networkmanager: Network page (connections, Wi-Fi, static IP)'
    'pacman-contrib: check for updates without touching the package database'
    'fakeroot: needed by checkupdates'
    'arch-audit: vulnerability scan'
    'grub: regenerate GRUB configuration'
    'ufw: firewall management'
    'firewalld: firewall management (alternative to ufw)'
    'openssh: SSH hardening toggles'
    'sudo: fallback privilege escalation and sudoers checking'
    'fail2ban: ban IPs after repeated failed logins'
    'apparmor: AppArmor profile management'
    'usbguard: USB device allow-listing'
    'audit: audit logging and SELinux denial review'
    'reflector: rank pacman mirrors'
    'fwupd: firmware devices and updates'
    'smartmontools: SMART disk health'
    'sbctl: Secure Boot key creation, enrollment and signing'
    'mokutil: fallback Secure Boot state check'
    'power-profiles-daemon: power profile switching'
    'zram-generator: zram swap configuration'
    'flatpak: Flatpak app updates and cleanup'
)
provides=('atropa')
conflicts=('atropa')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    local version
    version=$(sed -n 's/^version = "\(.*\)"/\1/p' pyproject.toml)
    printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$_pkgname"
    # Start from an empty dist/: makepkg keeps $srcdir between runs and a
    # different pkgver leaves an old wheel behind. `python -m installer`
    # happily installs *every* wheel it is given, so dist/*.whl matching two
    # versions makes it write usr/bin/atropa twice and fail in package().
    rm -rf dist
    python -m build --wheel --no-isolation
}

check() {
    cd "$_pkgname"
    python -m pytest
}

package() {
    cd "$_pkgname"
    local wheels=(dist/*.whl)
    if (( ${#wheels[@]} != 1 )); then
        error "expected exactly one wheel in dist/, found ${#wheels[@]}"
        exit 1
    fi
    python -m installer --destdir="$pkgdir" "${wheels[0]}"

    install -Dm644 atropa/resources/atropa.desktop -t "$pkgdir/usr/share/applications/"
    install -Dm644 atropa/resources/org.atropa.pkexec.policy -t "$pkgdir/usr/share/polkit-1/actions/"
    # The programs pkexec runs: root-owned, fixed paths, annotated in the
    # policy above (auth_admin_keep here, auth_admin for -ask below).
    install -Dm755 atropa/helper.py "$pkgdir/usr/lib/atropa/atropa-helper"
    # The same helper again under the path of the always-ask action, for
    # root-equivalent operations (see atropa/helper.py).
    install -Dm755 atropa/helper.py "$pkgdir/usr/lib/atropa/atropa-helper-ask"
    local icon
    for icon in atropa/resources/icons/hicolor/*/apps/org.atropa.Atropa.png; do
        install -Dm644 "$icon" "$pkgdir/usr/share/icons/${icon#atropa/resources/icons/}"
    done
    # makepkg's tarball stores each file's SELinux label (security.selinux
    # xattr) from the build directory - xdg_cache_t, user_tmp_t - and pacman
    # restores it on extraction, before the relabel hook fixes it at the end
    # of the transaction. polkitd reads the new policy in between, is denied,
    # and never retries, so Atropa's actions silently vanish until polkit
    # restarts. Package them with the label they get under /usr anyway.
    if command -v chcon >/dev/null && [[ -e /sys/fs/selinux/enforce ]]; then
        chcon -R -t usr_t "$pkgdir/usr" 2>/dev/null || true
    fi
}
